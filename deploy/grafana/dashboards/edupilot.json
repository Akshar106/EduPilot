        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "{{job}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process memory",
