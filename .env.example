# EduPilot — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# ─── LLM providers ───────────────────────────────────────────────────────────
# At least one is required. The default model is Groq, so GROQ_API_KEY is what
# you need unless you change DEFAULT_MODEL in src/edupilot/core/config.py.
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=your_key_here

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Postgres with the pgvector extension. It holds everything the app keeps:
# accounts, conversations, the vector index, checkpoints and caches. The
# default is the database `docker compose up -d db` starts on port 5434; the
# app creates its tables on startup.
DATABASE_URL=postgresql://edupilot:edupilot@localhost:5434/edupilot

# Connections per API process: a pool for request work, plus the async pool
# LangGraph uses. Keep processes x (pool + overflow + checkpoint pool) under
# your Postgres plan's connection limit.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# CHECKPOINT_POOL_SIZE=10

# ─── Scale-out ───────────────────────────────────────────────────────────────
# Redis for state every API process shares: rate limits and the global turn
# limit. Unset, each process keeps them in memory (fine for one process).
# REDIS_URL=redis://localhost:6380/0
#
# Turns answered at once per process, and across all processes (via Redis;
# 0 = off). Past them a question waits up to ADMISSION_TIMEOUT_SECONDS, then
# gets 503 with Retry-After. See docs/load-testing.md for how to size them.
# MAX_CONCURRENT_TURNS=4
# GLOBAL_MAX_TURNS=0
# ADMISSION_TIMEOUT_SECONDS=10
#
# Cross-encoder calls at once per process, and torch threads per call
# (0 = one per core). With several API processes on one machine, set
# INFERENCE_THREADS to cores / processes.
# INFERENCE_CONCURRENCY=1
# INFERENCE_THREADS=0
#
# Where uploads are indexed: "embedded" (a worker thread in each API process)
# or "external" (separate `edupilot-worker` processes).
# INGEST_WORKER=embedded
#
# Require `Authorization: Bearer <token>` on /metrics.
# METRICS_TOKEN=
#
# Load tests only: simulate every model call. Refused in production.
# LLM_SIMULATED=false
# SIMULATED_LLM_LATENCY_MS=400
# SIMULATED_LLM_TOKENS_PER_SECOND=150

# ─── Vector store ────────────────────────────────────────────────────────────
# pgvector (default) keeps vectors in the database above. pinecone uses a
# Pinecone serverless index instead and needs PINECONE_API_KEY.
# VECTOR_BACKEND=pgvector
# Base name for versioned indexes: edupilot-v1, -v2, ... The index_versions
# table records which one serves traffic.
# INDEX_BASE=edupilot

# Pinecone: the vector backend above, or the hosted models below.
# PINECONE_API_KEY=pcsk_your_key_here
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ─── Security (REQUIRED) ─────────────────────────────────────────────────────
# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. In production the app refuses to start
# without it rather than falling back to a predictable default — anyone who
# can guess the key can mint an admin token.
JWT_SECRET_KEY=

# Browser origins allowed to call the API, comma-separated. Defaults to
# localhost only. Do not use "*": it lets any website call this API with the
# user's credentials attached.
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Set true ONLY when running behind a reverse proxy you control. It makes the
# app trust X-Forwarded-For, which is client-controlled — trusting it without
# a proxy lets a caller forge a new identity per request and bypass rate limits.
TRUST_PROXY_HEADERS=false

# "production" enables secure cookies, disables /docs, and makes
# JWT_SECRET_KEY mandatory.
EDUPILOT_ENV=development

# Single-user mode. When false there is no sign-in: every request resolves to
# one fixed local identity with admin rights, which is what lets the bundled
# frontend work without a login screen.
#
# Defaults to false in development and true in production. Setting it false
# while EDUPILOT_ENV=production is refused at startup — an open knowledge base
# means any visitor can inject documents that every answer is then grounded in.
EDUPILOT_AUTH_REQUIRED=false

# First admin account, created on startup when no users exist. Without it the
# admin-only knowledge-base routes are unreachable on a fresh deployment.
BOOTSTRAP_ADMIN_EMAIL=you@university.edu
BOOTSTRAP_ADMIN_PASSWORD=

# Longest accepted question. Unbounded input is unbounded prompt cost.
MAX_QUERY_CHARS=4000

# ─── Models ──────────────────────────────────────────────────────────────────
# Local (needs `uv sync --extra local-models`): 384-dim, 512-token window.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Hosted on Pinecone Inference instead — no torch, no model download, uses
# PINECONE_API_KEY. The index must be rebuilt (`edupilot-reindex --rebuild`)
# after changing the embedding model; see "Hosted embeddings" in the README.
# EMBEDDING_MODEL=llama-text-embed-v2
# RERANKER_MODEL=bge-reranker-v2-m3

# ─── Tracing (LangSmith) ─────────────────────────────────────────────────────
# Off unless both are set. Traces every graph step, model call and tool call,
# and lets students' 👍/👎 attach to the trace of the answer they rated.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your_key_here
# LANGSMITH_PROJECT=edupilot
# Traces include questions and course excerpts. These keep the run structure,
# timings and token counts but drop the text:
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# ─── Textbooks ───────────────────────────────────────────────────────────────
# Files in a course's book/ subfolder are textbooks. Of the excerpts an answer
# is written from, at most this many come from a book while the course's own
# material can supply the rest ("none" lifts the limit).
# MAX_BOOK_EXCERPTS=2
# The same limit for any single file; off unless set.
# MAX_EXCERPTS_PER_DOCUMENT=

# ─── Query transformation ────────────────────────────────────────────────────
# Acronym expansion always runs (deterministic, free). These two each add an
# LLM round-trip per query, so they are off by default.
ENABLE_MULTI_QUERY=false
ENABLE_HYDE=false

# ─── Agentic behaviour ───────────────────────────────────────────────────────
# Each trades latency and tokens for answer quality.
# Grade retrieved excerpts with an LLM; when none address the question,
# rephrase the search in course terminology and retry before refusing.
CORRECTIVE_RETRIEVAL=true
MAX_QUERY_REWRITES=1
# When verification finds unsupported claims, revise and re-verify this many
# times (the better-scoring draft is kept). 0 disables revision.
MAX_REVISIONS=1
# Let the answering agent call the restricted calculator tool.
ENABLE_TUTOR_TOOLS=true

# ─── Files ───────────────────────────────────────────────────────────────────
# Root for the course corpus, which rebuilds read and citations link to.
# Defaults to <repo>/data. Everything else, student uploads included, is in
# the database.
# EDUPILOT_DATA_DIR=/var/lib/edupilot

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "json" for log aggregators, "human" for a terminal.
LOG_FORMAT=human
